# ── run manifests ───────────────────────────────────────
# scripts/run-payout.ts writes docs/notes/<net>-manifest.json on a confirmed
# run, and that file carries the run's runSalt — the payer-signature-derived
# secret that keeps every invoice reference in the run unguessable to an
# observer (Task 4). Committing it defeats that for the whole run, so it
# never goes into git even though the rest of docs/notes/ (the hand-written
# evidence notes) does.
docs/notes/*-manifest.json
# One run file is published on purpose: the mainnet proof run's, at
# frontend/public/proof/mainnet-run.json. Its invoices are samples, and a
# reviewer needs its salt to see the run's invoices and a receipt verify on
# mainnet. The salt comes from the payer signing the run name, so never pay a
# real list from 0x5955…de17 on mainnet under the run name "mainnet-2026-09":
# it would share this salt. docs/notes/2026-09-24-mainnet-proof.md has more.

# screenshots from browser checks are evidence for a moment, not artifacts
*.png
!frontend/app/**/*.png
# ...but an image the app serves is part of the app. The token icons sat
# here untracked: present on the machine that made them, missing from every
# deployment built from git. test/public-assets.test.ts fails on any
# referenced asset git would not ship.
!frontend/public/**/*.png

# visual companion mockups from brainstorming sessions
.superpowers/

# ── agent worktrees ─────────────────────────────────────
.claude/worktrees/

# ── walkthrough takes and renders (large, local) ─────────
video/
