{
  "name": "ledgerline",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "pnpm --filter @ledgerline/core build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @ledgerline/core build && pnpm --filter @ledgerline/web build",
    "reconcile": "pnpm --silent --filter @ledgerline/core build && tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@ledgerline/core": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "viem": "^2.56.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@10.33.0"
}
