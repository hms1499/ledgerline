# ── Ledgerline environment ───────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Arc pays gas in USDC from a real mainnet wallet. Use a wallet created
# solely for this demo and fund it with a few dollars — it appears in a
# public repo and should be treated as single-use.

# ── You fill these in ────────────────────────────────────────────────────

# Payer and deployer. `cast wallet new`
PRIVATE_KEY=

# The payer's address. Convenience only — scripts derive it from the key,
# but the balance checks in the plan use $ADDRESS.
#   cast wallet address --private-key $PRIVATE_KEY
ADDRESS=

# Who the demo pays. A second wallet, or any address you control.
# Must not be 0x0 — Arc reverts on value transfer to the zero address.
DEMO_RECIPIENT=

# ── Filled in after each deploy ──────────────────────────────────────────

# PayoutAnchor on Arc testnet. Set from the Task 14 deploy output.
ANCHOR_TESTNET=

# PayoutAnchor on Arc mainnet. Set from the Task 15 deploy output.
# This is submission artifact #1 and must be source-verified on the explorer.
ANCHOR_MAINNET=

# ── Optional ─────────────────────────────────────────────────────────────

# Overrides the default testnet RPC. viem says rpc.testnet.arc.network while
# the docs say rpc.testnet.arc.io — set this if the default proves wrong.
ARC_TESTNET_RPC=
