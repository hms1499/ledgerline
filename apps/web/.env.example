# ── Ledgerline web ───────────────────────────────────────────────────────
# Copy to .env.local. Every value here is public — a deployed contract
# address or a transaction hash anyone can read off the chain. There are no
# secrets in this file and there must never be: NEXT_PUBLIC_* is compiled
# into the browser bundle.
#
#   cp apps/web/.env.example apps/web/.env.local

# Which network the pages default to when the URL says nothing.
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# ── PayoutAnchor ─────────────────────────────────────────────────────────
# Without these the receipt page degrades to "anchor not checked" and the
# reconciliation view to "completeness unknown". It still verifies the
# payment itself, because that lives in the transaction's own logs.

NEXT_PUBLIC_ANCHOR_TESTNET=0xb8907A07768D936D1D498257E5803c91033a8802
# Set from the Task 15 mainnet deploy.
NEXT_PUBLIC_ANCHOR_MAINNET=

# ── /why — the two transactions it compares ──────────────────────────────
# A referenced run, and the same payment through the standard Multicall3.
# /why reads both off the chain and derives every claim from their logs;
# all three are overridable per-visit with ?ours= &naive= &approve=.

NEXT_PUBLIC_WHY_OURS_TESTNET=0x272c8fd186d17c042de60c9eb991b92b58fa960fee1f04842b01c7492c88a354
NEXT_PUBLIC_WHY_NAIVE_TESTNET=0xc7d9255d4c0fc793e261d4ca02f9df1985694a2f31401e15ab7ead6d27440bfe
NEXT_PUBLIC_WHY_APPROVE_TESTNET=0xe29621ec2283fe141ab5934b9a9e1890a6e62021ee28752345c4c3c09e907c2d

# Set from Task 16 and the mainnet negative control.
NEXT_PUBLIC_WHY_OURS_MAINNET=
NEXT_PUBLIC_WHY_NAIVE_MAINNET=
NEXT_PUBLIC_WHY_APPROVE_MAINNET=
